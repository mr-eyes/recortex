{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/skills/recortex/scripts/session_start_hook.sh\"",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "\"$HOME/.claude/skills/recortex/scripts/run_observer_hook.sh\" session-start",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/skills/recortex/scripts/run_hook.sh\" subagent-start",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$HOME/.claude/skills/recortex/scripts/run_observer_hook.sh\" subagent-start",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/skills/recortex/scripts/run_hook.sh\" prompt-submit",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"$HOME/.claude/skills/recortex/scripts/run_observer_hook.sh\" prompt-submit",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/skills/recortex/scripts/run_hook.sh\" pre-compact",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$HOME/.claude/skills/recortex/scripts/run_observer_hook.sh\" pre-compact",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/skills/recortex/scripts/run_observer_hook.sh\" pre-tool",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/skills/recortex/scripts/run_observer_hook.sh\" post-tool",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/skills/recortex/scripts/run_observer_hook.sh\" tool-failure",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/skills/recortex/scripts/run_observer_hook.sh\" stop",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/skills/recortex/scripts/run_observer_hook.sh\" subagent-stop",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
